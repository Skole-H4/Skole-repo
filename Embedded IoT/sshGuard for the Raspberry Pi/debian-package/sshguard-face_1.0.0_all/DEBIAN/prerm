#!/bin/bash
# prerm - Runs before package removal
set -e

case "$1" in
    remove|upgrade|deconfigure)
        echo "Stopping sshGuard service..."
        
        # Stop and disable service
        systemctl stop sshguard.service 2>/dev/null || true
        systemctl disable sshguard.service 2>/dev/null || true
        ;;
    
    failed-upgrade)
        ;;
    
    *)
        echo "prerm called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0
